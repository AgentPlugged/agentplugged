{
  "name": "agentplugged",
  "version": "1.3.0",
  "description": "Install the AgentPlugged method in a repository and make its agents callable from Claude Code, Codex, Antigravity CLI and Cursor.",
  "releaseSummary": "One circuit: pause the whole team, stop a story at its budget before the next tool call, and let Noah keep a note of each exchange.",
  "license": "FSL-1.1-MIT",
  "author": "Innovel Studio SASU",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentPlugged/agentplugged.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/AgentPlugged/agentplugged#readme",
  "bugs": {
    "url": "https://github.com/AgentPlugged/agentplugged/issues"
  },
  "type": "module",
  "keywords": [
    "agents",
    "ai",
    "claude-code",
    "codex",
    "antigravity-cli",
    "cursor",
    "cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agentplugged": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-METHOD"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@napi-rs/keyring": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "koffi": "catalog:"
  },
  "devDependencies": {
    "@agentplugged/adapters-git": "workspace:*",
    "@agentplugged/adapters-tools": "workspace:*",
    "@agentplugged/core": "workspace:*",
    "@agentplugged/crypto": "workspace:*",
    "@agentplugged/i18n": "workspace:*",
    "@agentplugged/mcp": "workspace:*",
    "@agentplugged/method": "workspace:*",
    "@agentplugged/protocol": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "tsdown": "~0.23.0",
    "vitest": "catalog:"
  }
}
