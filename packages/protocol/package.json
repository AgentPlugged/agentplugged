{
  "name": "@agentplugged/protocol",
  "version": "1.3.0",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "exports": {
    ".": {
      "@agentplugged/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./share": {
      "@agentplugged/source": "./src/share.ts",
      "types": "./dist/share.d.ts",
      "default": "./dist/share.js"
    },
    "./no-codegen": {
      "@agentplugged/source": "./src/no-codegen.ts",
      "types": "./dist/no-codegen.d.ts",
      "default": "./dist/no-codegen.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run --testTimeout=120000 --hookTimeout=120000"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
